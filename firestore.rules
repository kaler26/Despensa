rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Shared household pantry for dumber.wow@gmail.com & laura.lmp94@gmail.com
// Root path: users/{householdId} (where householdId == 'hogar-principal')
//
// Collection: users/{householdId}/containers/{containerId}
//   - uid: string (required, immutable, == householdId)
//   - name: string (required, 1..50 chars)
//   - type: string (required, in ['nevera', 'congelador', 'despensa', 'armario', 'otro'])
//   - createdAt: timestamp (required, immutable)
//
// Collection: users/{householdId}/products/{productId}
//   - uid: string (required, immutable, == householdId)
//   - name: string (required, 1..100 chars)
//   - category: string (required, 1..50 chars)
//   - location: string (required, 1..50 chars)
//   - quantity: number (required, 0..1000000)
//   - unit: string (required, in ['ud', 'kg', 'g', 'l', 'ml', 'paquete', 'lata'])
//   - notes: string (required, 0..500 chars)
//   - minQuantity: number (optional legacy field, 0..1000000)
//   - createdAt: timestamp (required, immutable)
//   - updatedAt: timestamp (required)
//
// Collection: users/{householdId}/shoppingList/{itemId}
//   - uid: string (required, immutable, == householdId)
//   - name: string (required, 1..100 chars)
//   - quantity: number (required, > 0 and <= 1000000)
//   - unit: string (required, in ['ud', 'kg', 'g', 'l', 'ml', 'paquete', 'lata'])
//   - checked: bool (required)
//   - notes: string (required, 0..300 chars)
//   - productId: string or null (optional, 1..100 chars when string)
//   - createdAt: timestamp (required, immutable)
//
// Collection: users/{householdId}/movements/{movementId}
//   - uid: string (required, immutable, == householdId)
//   - productId: string (required, 1..100 chars)
//   - productName: string (required, 1..100 chars)
//   - type: string (required, in ['compra', 'consumo', 'ajuste'])
//   - delta: number (required, != 0, -1000000..1000000)
//   - previousQuantity: number (required, 0..1000000)
//   - newQuantity: number (required, 0..1000000)
//   - unit: string (required, in ['ud', 'kg', 'g', 'l', 'ml', 'paquete', 'lata'])
//   - note: string (required, 0..300 chars)
//   - createdAt: timestamp (required, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Solo los correos dumber.wow@gmail.com y laura.lmp94@gmail.com tienen acceso
    function isAuthorizedHouseholdMember(householdId) {
      return isAuthenticated() &&
        (householdId == 'hogar-principal' || householdId == request.auth.uid) &&
        request.auth.token.email in [
          'dumber.wow@gmail.com',
          'laura.lmp94@gmail.com'
        ];
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidUnit(unit) {
      return unit is string &&
        unit in ['ud', 'kg', 'g', 'l', 'ml', 'paquete', 'lata'];
    }

    function isValidMovementType(movType) {
      return movType is string &&
        movType in ['compra', 'consumo', 'ajuste'];
    }

    function isValidContainerType(contType) {
      return contType is string &&
        contType in ['nevera', 'congelador', 'despensa', 'armario', 'otro'];
    }

    function isValidContainer(data, householdId) {
      let requiredFields = ['uid', 'name', 'type', 'createdAt'];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(requiredFields) &&
        data.uid is string &&
        data.uid == householdId &&
        validStringLength('name', 1, 50) &&
        isValidContainerType(data.type) &&
        data.createdAt is timestamp;
    }

    function isValidProduct(data, householdId) {
      let requiredFields = [
        'uid',
        'name',
        'category',
        'location',
        'quantity',
        'unit',
        'notes',
        'createdAt',
        'updatedAt'
      ];
      let allowedFields = [
        'uid',
        'name',
        'category',
        'location',
        'quantity',
        'unit',
        'minQuantity',
        'notes',
        'createdAt',
        'updatedAt'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        data.uid is string &&
        data.uid == householdId &&
        validStringLength('name', 1, 100) &&
        validStringLength('category', 1, 50) &&
        validStringLength('location', 1, 50) &&
        data.quantity is number &&
        data.quantity >= 0 &&
        data.quantity <= 1000000 &&
        isValidUnit(data.unit) &&
        (!('minQuantity' in data) || (data.minQuantity is number && data.minQuantity >= 0 && data.minQuantity <= 1000000)) &&
        validStringLength('notes', 0, 500) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShoppingListItem(data, householdId) {
      let requiredFields = [
        'uid',
        'name',
        'quantity',
        'unit',
        'checked',
        'notes',
        'createdAt'
      ];
      let allowedFields = [
        'uid',
        'name',
        'quantity',
        'unit',
        'checked',
        'notes',
        'productId',
        'createdAt'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        data.uid is string &&
        data.uid == householdId &&
        validStringLength('name', 1, 100) &&
        data.quantity is number &&
        data.quantity > 0 &&
        data.quantity <= 1000000 &&
        isValidUnit(data.unit) &&
        data.checked is bool &&
        validStringLength('notes', 0, 300) &&
        (!('productId' in data) || data.productId == null || (data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 100)) &&
        data.createdAt is timestamp;
    }

    function isValidMovement(data, householdId) {
      let requiredFields = [
        'uid',
        'productId',
        'productName',
        'type',
        'delta',
        'previousQuantity',
        'newQuantity',
        'unit',
        'note',
        'createdAt'
      ];
      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(requiredFields) &&
        data.uid is string &&
        data.uid == householdId &&
        validStringLength('productId', 1, 100) &&
        validStringLength('productName', 1, 100) &&
        isValidMovementType(data.type) &&
        data.delta is number &&
        data.delta != 0 &&
        data.delta >= -1000000 &&
        data.delta <= 1000000 &&
        data.previousQuantity is number &&
        data.previousQuantity >= 0 &&
        data.previousQuantity <= 1000000 &&
        data.newQuantity is number &&
        data.newQuantity >= 0 &&
        data.newQuantity <= 1000000 &&
        isValidUnit(data.unit) &&
        validStringLength('note', 0, 300) &&
        data.createdAt is timestamp;
    }

    match /users/{householdId} {
      allow read, write: if isAuthorizedHouseholdMember(householdId);

      match /containers/{containerId} {
        allow read: if isAuthorizedHouseholdMember(householdId);
        allow create: if isAuthorizedHouseholdMember(householdId) &&
          isValidContainer(request.resource.data, householdId);
        allow update: if isAuthorizedHouseholdMember(householdId) &&
          areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
          isValidContainer(request.resource.data, householdId);
        allow delete: if isAuthorizedHouseholdMember(householdId);
      }

      match /products/{productId} {
        allow read: if isAuthorizedHouseholdMember(householdId);
        allow create: if isAuthorizedHouseholdMember(householdId) &&
          isValidProduct(request.resource.data, householdId);
        allow update: if isAuthorizedHouseholdMember(householdId) &&
          areImmutableFieldsUnchanged(['uid']) &&
          isValidProduct(request.resource.data, householdId);
        allow delete: if isAuthorizedHouseholdMember(householdId);
      }

      match /shoppingList/{itemId} {
        allow read: if isAuthorizedHouseholdMember(householdId);
        allow create: if isAuthorizedHouseholdMember(householdId) &&
          isValidShoppingListItem(request.resource.data, householdId);
        allow update: if isAuthorizedHouseholdMember(householdId) &&
          areImmutableFieldsUnchanged(['uid', 'createdAt']) &&
          isValidShoppingListItem(request.resource.data, householdId);
        allow delete: if isAuthorizedHouseholdMember(householdId);
      }

      match /movements/{movementId} {
        allow read: if isAuthorizedHouseholdMember(householdId);
        allow create: if isAuthorizedHouseholdMember(householdId) &&
          isValidMovement(request.resource.data, householdId);
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
